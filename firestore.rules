rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, then Publish.
// Each signed-in person can read and write only their own tracker (users/<their uid>/docs/...).
// Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/docs/{docId} {
      // Reading the whole list is a query, where the document name isn't known yet,
      // so the read rule checks only who is asking.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && docId.size() <= 64;
    }
  }
}
